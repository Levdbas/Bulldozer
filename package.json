{
  "name": "bulldozer-docs",
  "version": "5.12.6",
  "description": "Documentation for Bulldozer - A collection of classes to extend your Timber-based WordPress theme",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "docs:start": "docusaurus start --config docs/docusaurus.config.ts",
    "docs:build": "docusaurus build --config docs/docusaurus.config.ts --out-dir docs/build",
    "docs:serve": "docusaurus serve --config docs/docusaurus.config.ts",
    "docs:clear": "docusaurus clear --config docs/docusaurus.config.ts",
    "translate:pot": "wp i18n make-pot ./src src/lang/bulldozer.pot --slug=bulldozer --exclude=node_modules,vendor",
    "translate:make-php": "wp i18n make-php src/lang/ src/lang/"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@easyops-cn/docusaurus-search-local": "^0.55.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "gh-pages": "^5.0.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levdbas/Bulldozer.git"
  },
  "keywords": [
    "wordpress",
    "timber",
    "blocks",
    "documentation"
  ],
  "author": "Levdbas",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Levdbas/Bulldozer/issues"
  },
  "homepage": "https://levdbas.github.io/Bulldozer/"
}
